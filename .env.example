# --- Model (required) ---
# Any OpenAI-compatible chat-completions API with tool calling.
# Groq example (free tier, create a key at https://console.groq.com/keys):
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
# OpenAI example:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# Local Ollama example (no key needed, still set LLM_API_KEY to any string):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:4b-instruct

# --- Web search (optional; at least one is recommended) ---
# Brave Search API key (free tier: https://brave.com/search/api/). Used first when set.
BRAVE_API_KEY=
# Tavily API key (free tier: https://tavily.com). Used when Brave is unset or fails.
TAVILY_API_KEY=
# With neither key set, the agent falls back to keyless DuckDuckGo HTML search.

# --- Storage (optional) ---
# Where conversation memory lives. Defaults to ./memory.db
# MEMORY_DB=./memory.db
